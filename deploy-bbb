#!/bin/bash
# Copy the built "demo" binary to a BeagleBone Black over scp.
# On the BBB the QUniBone tree is laid out directly under root's home
# directory (see qunibone-platform.sh), so the target path mirrors the
# local repo layout: 10.03_app_demo/4_deploy_u|q/demo under ~root.
echo "Deploying demo binary to BeagleBone Black"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"

CROSSCOMPILE_ENV="$SCRIPT_DIR/crosscompile.env"
if [ ! -f "$CROSSCOMPILE_ENV" ]; then
  echo "Error: $CROSSCOMPILE_ENV not found. Run ./crossco once to create and configure it." >&2
  exit 1
fi
. "$CROSSCOMPILE_ENV"

if [ -z "$BBB_HOST" ]; then
  echo "Error: BBB_HOST is not set in $CROSSCOMPILE_ENV." >&2
  echo "Set it to the BeagleBone's hostname or IP address (see crosscompile.env.example)." >&2
  exit 1
fi

# QUNIBONE_PLATFORM from qunibone-platform.env, plus the derived _u/_q suffix
. "$SCRIPT_DIR/qunibone-platform-env.sh" || exit 1

RELATIVE_DIR="10.03_app_demo/4_deploy$QUNIBONE_PLATFORM_SUFFIX"
LOCAL_BINARY="$SCRIPT_DIR/$RELATIVE_DIR/demo"

if [ ! -f "$LOCAL_BINARY" ]; then
  echo "Error: $LOCAL_BINARY not found. Build it first with ./crossco." >&2
  exit 1
fi

echo "Target: root@$BBB_HOST:~/$RELATIVE_DIR/demo"

ssh "root@$BBB_HOST" "mkdir -p ~/$RELATIVE_DIR" || exit 1
scp "$LOCAL_BINARY" "root@$BBB_HOST:~/$RELATIVE_DIR/demo" || exit 1

echo "Done."
