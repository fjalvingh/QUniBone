# makefile_u: UNIBUS build of "demo".
# Only the UNIBUS/QBUS deltas live here; everything shared is in
# makefile.common. Add new device objects THERE, unless the device exists on
# one bus only.

PLATFORM_SUFFIX = _u
PLATFORM_CCDEFS = -DUNIBUS
PRU1_CODE_BUSNAME = unibus

# devices existing on UNIBUS only
PLATFORM_OBJECTS = \
	$(OBJDIR)/m9312.o \
	$(OBJDIR)/ke11.o

include makefile.common

# rules for the UNIBUS-only devices (OBJDIR is set by makefile.common)
$(OBJDIR)/m9312.o :  $(DEVICE_SRC_DIR)/m9312.cpp $(DEVICE_SRC_DIR)/m9312.hpp
	$(CC) $(CCFLAGS) $< -o $@

$(OBJDIR)/ke11.o :   $(DEVICE_SRC_DIR)/ke11.cpp $(DEVICE_SRC_DIR)/ke11.hpp
	$(CC) $(CCFLAGS) $< -o $@
