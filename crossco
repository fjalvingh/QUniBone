#!/bin/bash
# Cross-compile QUniBone for the BeagleBone Black from an x86_64 host.
# See https://github.com/robamu-org/beaglebone-crosscompiling
echo "Entering BeagleBoneBlack environment"

# The root of the github repository: wherever this script itself lives
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
export QUNIBONE_DIR="$SCRIPT_DIR"

COMPILE_COMMANDS="$SCRIPT_DIR/compile_commands.json"

CLEAN=0
GENERATE_COMPILE_COMMANDS=0
BUILD_CONFIGURATION=DBG
# The automated tests run natively on this host: the CPU emulation cores
# (10.05_cputest) and the shared utilities of 90_common (90_common/test).
# SKIP_CPUTESTS from the environment does the same as -n.
RUN_TESTS=1
if [ -n "$SKIP_CPUTESTS" ] && [ "$SKIP_CPUTESTS" != "0" ]; then
  RUN_TESTS=0
fi
for arg in "$@"; do
  case "$arg" in
    -a) CLEAN=1 ;;
    -c) GENERATE_COMPILE_COMMANDS=1 ;;
    -r) BUILD_CONFIGURATION=RELEASE ;;
    -n) RUN_TESTS=0 ;;
    *)
      echo "Usage: $0 [-a] [-c] [-r] [-n]" >&2
      echo "  -a  make clean before building (full rebuild)" >&2
      echo "  -c  (re)generate compile_commands.json (for IDE code completion), via 'bear'" >&2
      echo "  -r  release build (-O3, no debug symbols); default is a DBG build (-ggdb3 -O0)" >&2
      echo "  -n  skip the automated tests (same as SKIP_CPUTESTS=1)" >&2
      exit 1
      ;;
  esac
done

# Auto-generate compile_commands.json on first use, so IDE setup doesn't
# require a separate manual step.
if [ ! -f "$COMPILE_COMMANDS" ]; then
  GENERATE_COMPILE_COMMANDS=1
fi
# A stale compile_commands.json (missing entries for files that were already
# built and thus skipped by an incremental make) is worse than none: force a
# full rebuild whenever we (re)generate it.
if [ "$GENERATE_COMPILE_COMMANDS" -eq 1 ]; then
  CLEAN=1
fi

# Platform + toolchain settings (QUNIBONE_PLATFORM, GCC_ROOT, PRU_CGT, BBB_CC, ...).
# crosscompile.env is user-specific and gitignored; bootstrap it from the
# committed example on first use.
CROSSCOMPILE_ENV="$SCRIPT_DIR/crosscompile.env"
CROSSCOMPILE_ENV_EXAMPLE="$SCRIPT_DIR/crosscompile.env.example"
if [ ! -f "$CROSSCOMPILE_ENV" ]; then
  cp "$CROSSCOMPILE_ENV_EXAMPLE" "$CROSSCOMPILE_ENV"
  echo "Created $CROSSCOMPILE_ENV from crosscompile.env.example." >&2
  echo "Edit it to set QUNIBONE_PLATFORM and your toolchain paths, then run ./crossco again." >&2
  exit 1
fi
. "$CROSSCOMPILE_ENV"
export QUNIBONE_PLATFORM

# QUNIBONE_PLATFORM_SUFFIX is derived from QUNIBONE_PLATFORM, never set directly.
case "$QUNIBONE_PLATFORM" in
  UNIBUS) export QUNIBONE_PLATFORM_SUFFIX=_u ;;
  QBUS)   export QUNIBONE_PLATFORM_SUFFIX=_q ;;
  *)
    echo "Error: QUNIBONE_PLATFORM in $CROSSCOMPILE_ENV must be set to UNIBUS or QBUS (got '$QUNIBONE_PLATFORM')." >&2
    exit 1
    ;;
esac

# Whether it is a RELEASE or a DBG build; DBG by default so a binary built by
# ./crossco is remote-debuggable (-ggdb3 -O0) without extra steps. Pass -r for
# an optimized release build instead.
export MAKE_CONFIGURATION="$BUILD_CONFIGURATION"

export MAKE_TARGET_ARCH="BBB"

# Validate the toolchain, not just that variables are non-empty: catches a
# stale or not-yet-edited crosscompile.env with a clear message instead of a
# confusing failure deep inside make/gcc.
error=0

require_var() {
  if [ -z "${!1}" ]; then
    echo "Error: variable $1 is not set in $CROSSCOMPILE_ENV." >&2
    error=1
  fi
}

require_executable() {
  # $1 = variable name (for the message), $2 = path that must be an executable file
  if [ ! -x "$2" ]; then
    echo "Error: $1 does not point at a valid toolchain: expected executable not found at $2" >&2
    error=1
  fi
}

require_var GCC_ROOT
require_var PRU_CGT
require_var BBB_CC

[ -n "$GCC_ROOT" ] && require_executable GCC_ROOT "$GCC_ROOT/bin/arm-linux-gnueabihf-gcc"
[ -n "$PRU_CGT" ] && require_executable PRU_CGT "$PRU_CGT/bin/clpru"
if [ -n "$BBB_CC" ]; then
  # BBB_CC holds "compiler-path plus flags"; only the first word is the executable
  set -- $BBB_CC
  require_executable BBB_CC "$1"
fi

if [ "$error" -ne 0 ]; then
  echo "Fix the above in $CROSSCOMPILE_ENV and try again." >&2
  exit 1
fi

CPUTEST_DIR="$QUNIBONE_DIR/10.05_cputest/2_src"
COMMONTEST_DIR="$QUNIBONE_DIR/90_common/test"

cd "$QUNIBONE_DIR/10.03_app_demo/2_src" || exit 1

if [ "$CLEAN" -eq 1 ] ; then
  make clean
  make -C "$CPUTEST_DIR" clean
  make -C "$COMMONTEST_DIR" clean
fi

if [ "$GENERATE_COMPILE_COMMANDS" -eq 1 ]; then
  if ! command -v bear >/dev/null 2>&1; then
    echo "Error: 'bear' is required to generate compile_commands.json (sudo apt install bear)." >&2
    exit 1
  fi
  bear --output "$COMPILE_COMMANDS" -- make || exit 1
  # The cputest harness sources (papertape.cpp, testbus.cpp, ...) are unique to
  # this host-compiled build and never appear in the ARM one, so add them too.
  # Skip ka11.o/kd11ea.o/kt11d.o (CORE_OBJECTS in the cputest makefile): those
  # source files ARE already in the database from the ARM build with
  # -DARM/-DUNIBUS, and compiling them again here without those defines would
  # just overwrite those entries with flags no real device build ever uses.
  CPUTEST_OBJDIR="$QUNIBONE_DIR/10.05_cputest/4_deploy"
  CPUTEST_HARNESS_OBJS="$CPUTEST_OBJDIR/cputest.o $CPUTEST_OBJDIR/papertape.o $CPUTEST_OBJDIR/testbus.o $CPUTEST_OBJDIR/testcore.o $CPUTEST_OBJDIR/testcore_cpu20.o $CPUTEST_OBJDIR/testcore_cpu34.o"
  bear --append --output "$COMPILE_COMMANDS" -- make -C "$CPUTEST_DIR" $CPUTEST_HARNESS_OBJS || exit 1
  # Same for the 90_common test sources. Only the tests themselves: the units
  # under test (getopt2.cpp, ...) are in the database from the ARM build already.
  bear --append --output "$COMPILE_COMMANDS" -- make -C "$COMMONTEST_DIR" testobjects || exit 1
else
  make || exit 1
fi

# Run the automated tests: the CPU emulation cores against the MAINDEC
# diagnostics, and the shared utilities of 90_common. Built and run by the HOST
# compiler, so they work while "demo" is cross compiled for ARM. Stamp driven:
# a no-op unless a tested source or a harness changed.
if [ "$RUN_TESTS" -eq 1 ]; then
  make -C "$COMMONTEST_DIR" || exit 1
  make -C "$CPUTEST_DIR" -j"$(nproc 2>/dev/null || echo 1)" || exit 1
fi
cd ~
