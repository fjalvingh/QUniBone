# This diagnostic drives the KL11 itself: it sends the whole character set,
# 0 to 177 and round again, through the interrupt driven transmitter. A BEL is
# character 007 of that sweep, so the usual "a BEL ends a pass" rule would call
# the run passed after 634 instructions, on the seventh character it prints.
# The run therefore has to be judged some other way, and until it is, the tape
# counts as failing: it currently halts at 003300 after 13 sweeps.
bell-is-pass = 0
