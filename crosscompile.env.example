# crosscompile.env.example
#
# Template for crosscompile.env: toolchain settings for cross-compiling
# QUniBone (PRU firmware + the ARM "demo" binary) on an x86_64 Linux host.
# Sourced by ./crossco, which sets QUNIBONE_DIR itself (derived from its own
# location) before sourcing this.
#
# This .example file is committed to git; crossco copies it to
# crosscompile.env on first use, and that copy is gitignored since it holds
# your local settings. Edit crosscompile.env, not this file.
#
# The target platform is NOT set here: UNIBUS or QBUS is defined once in
# qunibone-platform.env (QUNIBONE_PLATFORM), for this build and for the
# BeagleBone build alike. crossco creates that file from
# qunibone-platform.env.example if it is missing.

# Toolchain paths below are expressed relative to $HOME so that, if you ever
# do want to commit your own crosscompile.env, it stays user-independent as
# long as everyone's toolchain installs follow the same layout under their
# own home directory.

# ARM cross toolchain (targets the BeagleBone Black's AM335x/Cortex-A8)
#export GCC_ROOT="$HOME/opt/gcc-linaro-7.5.0-2019.12-x86_64_arm-linux-gnueabihf"
#export CROSS_COMPILE="arm-cortex_a8-linux-gnueabihf"
#export BBB_CC="$GCC_ROOT/bin/arm-linux-gnueabihf-gcc -mthumb-interwork -mfloat-abi=hard -mfpu=neon -march=armv7-a"
#export PATH="$GCC_ROOT/bin:$PATH"

# TI PRU compiler (for pru0/pru1 firmware)
#export PRU_CGT="$HOME/opt/ti-cgt-pru_2.3.3"

# Hostname or IP address of the target BeagleBone Black, reachable via
# ssh/scp as user "root" (e.g. "192.168.1.50" or "beaglebone.local").
# Used by ./deploy-bbb to copy the built "demo" binary onto the device, and by
# ./debug-bbb to start gdbserver on it for VS Code remote debugging.
#export BBB_HOST=beaglebone.local

# TCP port ./debug-bbb starts gdbserver on. Must match the port used in
# .vscode/launch.json's miDebuggerServerAddress. Optional, defaults to 2345.
#export GDBSERVER_PORT=2345

export CONSOLE_PREFIX="[BBB]"

